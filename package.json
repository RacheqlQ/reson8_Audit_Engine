{
  "name": "reson8-audit-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json",
    "sample-report": "npm run build && node scripts/sample-report.mjs",
    "start": "node --env-file-if-exists=/etc/secrets/Secrets.env dist/main.js",
    "worker": "node --env-file-if-exists=/etc/secrets/Secrets.env dist/worker-main.js",
    "evaluate:genres": "npm run build && node scripts/genre-evaluation.mjs",
    "benchmark:key": "npm run build && node scripts/benchmark-key-estimation.mjs",
    "sample-report:v2": "node scripts/sample-report-v2.mjs"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "zod": "^4.1.0",
    "@supabase/supabase-js": "2.117.2",
    "ffmpeg-static": "5.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "@cantoo/pdf-lib": "2.11.1",
    "@audio/neural-separate": "0.7.1",
    "@audio/neural-runtime": "0.2.1",
    "onnxruntime-node": "1.31.1"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  },
  "packageManager": "npm@11.21.0"
}\n