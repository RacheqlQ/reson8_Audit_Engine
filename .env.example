NODE_ENV=development
PORT=10000
AUDD_API=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_COUNTRY_CODE=US
AUDIOMACK_CONSUMER_KEY=
AUDIOMACK_CONSUMER_SECRET=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
GROQ_API=
GROQ_MODEL=openai/gpt-oss-120b
PUBLIC_AUDIT_OWNER_EMAIL=audit-public@reson8.local
PUBLIC_AUDIT_RATE_LIMIT_PER_HOUR=30
PROVIDER_ENABLED_GROQ=false
PROVIDER_ENABLED_AUDD=false
PROVIDER_ENABLED_SPOTIFY=false
PROVIDER_ENABLED_APPLE_MUSIC=false
PROVIDER_ENABLED_YOUTUBE_MUSIC=false
PROVIDER_ENABLED_TIDAL=false
PROVIDER_ENABLED_AUDIOMACK=false
PROVIDER_ENABLED_DEEZER=false
PROVIDER_ENABLED_MUSICBRAINZ=false
PROVIDER_ENABLED_LISTENBRAINZ=false
PROVIDER_ENABLED_YOUTUBE=false
PROVIDER_ENABLED_LASTFM=false
LASTFM_COMMERCIAL_AGREEMENT=false
PROVIDER_ENABLED_BEAT_THIS=false
PROVIDER_ENABLED_FMAK=false
PROVIDER_ENABLED_GIANTSTEPS=false
PROVIDER_ENABLED_CHARTMETRIC=false
PROVIDER_ENABLED_SOUNDCHARTS=false
PROVIDER_ENABLED_LUMINATE=false
PROVIDER_ENABLED_ESSENTIA=false
PROVIDER_ENABLED_MADMOM=false
PAYMENTS_ENABLED=false
RESON8_OPERATOR_KEY=

# true: embedded API worker owns queue polling; false: standalone worker owns polling
RUN_WORKER_IN_API=true

# Reap processing jobs only after their lease has expired and they exceed this age (milliseconds)
AUDIT_JOB_STALE_TIMEOUT_MS=600000
